# At least one LLM provider is required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EDITOR_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LLM_PROVIDER=auto

# Voice: when both ElevenLabs values are set, ElevenLabs is used; otherwise Edge TTS is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# Free stock footage: the generator tries Pexels first, then Pixabay.
PEXELS_API_KEY=
PIXABAY_API_KEY=
TAVILY_API_KEY=

# Optional direct URL to a licensed/authorized music file. Must be a direct audio URL.
MUSIC_URL=
