# Configure a hosted API key for one of the supported documentary LLM providers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EDITOR_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_PROVIDER=auto
# Voice: when both ElevenLabs values are set, ElevenLabs is used; otherwise Edge TTS is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# Free stock footage: Pexels -> Pixabay -> Wikimedia Commons -> openly licensed Internet Archive footage.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Preferred live web research. Falls back to Tavily/Wikipedia/Europe PMC when unavailable.
PERPLEXITY_API_KEY=
TAVILY_API_KEY=

# Optional direct URL to a soundtrack you are authorized to use. If empty, the pipeline searches Internet Archive for CC0/CC BY music, then creates a quiet original ambient bed with FFmpeg.
MUSIC_URL=

# Optional local engine experiments (off by default; do not install all dependencies blindly).
# Set JACKPOCKETS_ALIGNER=whisperx to test WhisperX instead of Faster-Whisper.
JACKPOCKETS_ALIGNER=faster-whisper
# Aggregate limit across all downloaded footage for one documentary (default 1 GB).
JACKPOCKETS_MAX_TOTAL_ASSET_DOWNLOAD_BYTES=1000000000

# Set JACKPOCKETS_SEMANTIC_RANKING=1 to opt into local sentence-transformer reranking.
JACKPOCKETS_SEMANTIC_RANKING=0
JACKPOCKETS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
JACKPOCKETS_EMBEDDING_DEVICE=cpu
# Set TTS_PROVIDER=kokoro or piper to explicitly use local narration and avoid paid TTS fallbacks.
TTS_PROVIDER=auto
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
# Optional post-render diagnostics: python video_qc.py out/final.mp4 --out out/video-qc.json
JACKPOCKETS_VIDEO_QC=0
